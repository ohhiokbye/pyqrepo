# Next.js / server-only database
DATABASE_URL="postgresql://cpyq_user:cpyq_password@localhost:5433/cpyq?schema=public"
APP_URL="http://localhost:3000"
AUTH_SECRET=""
UPLOAD_TOKEN_SECRET=""
ADMIN_EMAILS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
WORKER_INTERNAL_KEY=""

# Development disk or private S3 for production
STORAGE_DRIVER="local"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# Local worker (outbound only)
FRONTEND_URL="http://localhost:3000"
# Owner keys are used only for shared-library ingestion.
INGESTION_GEMINI_API_KEY=""
INGESTION_GROQ_API_KEY=""
GEMINI_EXTRACTION_MODEL="gemini-3.1-flash-lite"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# Tutor model configuration (students provide their own keys)
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
GROQ_CHAT_MODEL="openai/gpt-oss-20b"
LLM_FALLBACK_BASE_URL="https://api.groq.com/openai/v1"
