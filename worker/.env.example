# The worker also loads the repo root .env as a fallback, so most values
# below are typically only needed here if you want to override the root .env.

# Security: must match WORKER_INTERNAL_KEY in the root/.frontend .env files.
WORKER_INTERNAL_KEY="change-me"

# AI / Provider Abstractions
LLM_PROVIDER="gemini"
OCR_PROVIDER="tesseract"
GEMINI_API_KEY=""

# Backup LLM for text generation when Gemini is out of quota / overloaded.
# Any OpenAI-compatible API works; defaults target Groq (free key: console.groq.com).
# Leave LLM_FALLBACK_API_KEY empty to disable. Embeddings always use Gemini.
LLM_FALLBACK_BASE_URL="https://api.groq.com/openai/v1"
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL="llama-3.3-70b-versatile"

# Frontend base URL, used to call back into the Next.js API
FRONTEND_URL="http://localhost:3000"

# Storage Driver: "local" for local disk or "s3" for AWS S3 (S3 not implemented yet)
STORAGE_DRIVER="local"
