# The worker also loads the repo root .env as a fallback, so most values
# below are typically only needed here if you want to override the root .env.

# Security: must match WORKER_INTERNAL_KEY in the root/.frontend .env files.
WORKER_INTERNAL_KEY="change-me"

# AI / Provider Abstractions
LLM_PROVIDER="gemini"
OCR_PROVIDER="tesseract"
GEMINI_API_KEY=""

# Frontend base URL, used to call back into the Next.js API
FRONTEND_URL="http://localhost:3000"

# Storage Driver: "local" for local disk or "s3" for AWS S3 (S3 not implemented yet)
STORAGE_DRIVER="local"
