generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector must be enabled before Question.embedding can be created;
  // `prisma db push` runs CREATE EXTENSION IF NOT EXISTS for this.
  extensions = [vector]
}

model Course {
  id        String          @id @default(cuid())
  code      String          @unique
  title     String
  credits   Int
  modules   Module[]
  papers    Paper[]
  materials StudyMaterial[]
  syllabusVersions SyllabusVersion[]
  questionPatterns QuestionPattern[]
  activeSyllabusVersionId String?
}

model Module {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])
  moduleNo Int
  name     String
  topics   Topic[]
  syllabusVersionId String?
  syllabusVersion SyllabusVersion? @relation(fields: [syllabusVersionId], references: [id])

  @@unique([syllabusVersionId, moduleNo])
  @@index([courseId])
}

model Topic {
  id             String          @id @default(cuid())
  moduleId       String
  module         Module          @relation(fields: [moduleId], references: [id])
  topicName      String
  questionTopics QuestionTopic[]
}

model File {
  id           String          @id @default(cuid())
  s3Key        String          @unique
  // Nullable until the worker computes the real hash; Postgres allows multiple
  // NULLs under a unique constraint, so this needs no placeholder value.
  sha256Hash   String?         @unique
  uploadedAt   DateTime        @default(now())
  
  submissions  Submission[]
  jobs         ProcessingJob[]
  papers       Paper[]
  materials    StudyMaterial[]
  syllabusVersions SyllabusVersion[]
}

model Submission {
  id            String   @id @default(cuid())
  fileId        String
  file          File     @relation(fields: [fileId], references: [id])
  contributorId String?  // Using a string ID for now since authentication models are skipped in Release 1
  status        String   // e.g. PENDING, APPROVED, REJECTED
  submittedAt   DateTime @default(now())
}

model Paper {
  id        String     @id @default(cuid())
  fileId    String
  file      File       @relation(fields: [fileId], references: [id])
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id])
  examType  String     // e.g., CAT1, CAT2, FAT
  year      Int?
  
  questions Question[]
  analysedSyllabusVersionId String?
  extractionVersion String?
  analysisComplete Boolean @default(false)
  duplicateOfPaperId String?
  sharedInstructions String?
  publicationStatus String @default("PROCESSING") // PROCESSING, AUTO_PUBLISHED, RETRY_PENDING
}

model Question {
  id               String          @id @default(cuid())
  paperId          String
  paper            Paper           @relation(fields: [paperId], references: [id])
  questionNumber   String          // e.g., "Q5(a)", "Q5(b)"
  marks            Float?
  extractedText    String
  imageCropS3Key   String?
  pageIndex        Int?
  boundingBox      Json?
  textHash         String?
  duplicateOfId    String?
  embeddingModel   String?

  @@index([textHash])
  @@index([patternId])

  // pgvector column (gemini-embedding-001, 768 dims) used for semantic retrieval:
  // lets the tutor find questions that match a student's meaning, not just their
  // exact wording. Prisma can't read/write "Unsupported" columns directly - all
  // access goes through $queryRaw/$executeRaw (see lib/embeddings.ts). The vector
  // type comes from the pgvector extension enabled in the datasource block above.
  embedding        Unsupported("vector(768)")?

  sourcePages Int[] @default([])
  sharedInstructions String?
  parentQuestionNumber String?
  marksScope String @default("QUESTION")
  patternId String?
  pattern QuestionPattern? @relation(fields: [patternId], references: [id])

  questionTopics   QuestionTopic[]

  // Prevents duplicate question rows when a job is retried or double-processed.
  @@unique([paperId, questionNumber])
}

model QuestionTopic {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  confidence Float?

  @@id([questionId, topicId])
}

model StudyMaterial {
  id           String @id @default(cuid())
  courseId     String
  course       Course @relation(fields: [courseId], references: [id])
  fileId       String
  file         File   @relation(fields: [fileId], references: [id])
  title        String
  documentType String // e.g., PPT, NOTES, REFERENCE
  publicationStatus String @default("PROCESSING")
  extractionVersion String?
  pageCount Int?
  chunks MaterialChunk[]
  pages MaterialPage[]
}

model MaterialPage {
  id String @id @default(cuid())
  materialId String
  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  pageIndex Int
  fileHash String
  extractionVersion String
  text String
  heading String
  method String
  @@unique([materialId, pageIndex])
}

model MaterialChunk {
  id String @id @default(cuid())
  materialId String
  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  position Int
  text String
  heading String
  sourcePages Int[]
  method String
  extractionVersion String
  @@unique([materialId, position])
}

model ApiRateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model ProcessingJob {
  id            String   @id @default(cuid())
  fileId        String
  file          File     @relation(fields: [fileId], references: [id])
  status        String   // e.g. PENDING, PROCESSING (claimed by a worker), DOWNLOADING, VALIDATING, TEXT_EXTRACTION, OCR_PROCESSING, QUESTION_SEGMENTATION, CLASSIFICATION, REVIEW_REQUIRED, COMPLETED, FAILED
  stage         String?
  errorCategory String?
  durationMs    Int?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attempts      ExtractionAttempt[]
  qualityResult QualityResult?
  leaseToken    String?
  leaseExpiresAt DateTime?
  nextRetryAt   DateTime? @default(now())
  retries       JobRetry[]

  @@index([status, nextRetryAt])
}

model SyllabusVersion {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  fileId      String
  file        File     @relation(fields: [fileId], references: [id])
  version     Int
  status      String   @default("AUTO_PUBLISHED")
  extractedAt DateTime @default(now())
  modules     Module[]

  @@unique([courseId, version])
}

model ExtractionAttempt {
  id        String        @id @default(cuid())
  jobId     String
  job       ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider  String
  status    String
  details   Json?
  createdAt DateTime      @default(now())
}

model QualityResult {
  id                    String        @id @default(cuid())
  jobId                 String        @unique
  job                   ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ocrConfidence         Float
  segmentationCoverage  Float
  checks                Json?
  questionCount         Int
  reasons               Json?
  createdAt             DateTime      @default(now())
}

model JobRetry {
  id String @id @default(cuid())
  jobId String
  job ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason String
  scheduledAt DateTime
  createdAt DateTime @default(now())
}

model QuestionPattern {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id])
  syllabusVersionId String
  signature String
  description String
  questions Question[]

  @@unique([courseId, syllabusVersionId, signature])
}
