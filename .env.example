# Database (Local PostgreSQL with pgvector — see docker-compose.yml)
DATABASE_URL="postgresql://cpyq_user:cpyq_password@localhost:5433/cpyq?schema=public"
POSTGRES_PASSWORD="cpyq_password"

# Storage Driver: "local" for local disk or "s3" for AWS S3 (S3 not implemented yet)
STORAGE_DRIVER="local"

# Security: Contributor upload authorization token. Change this from the default.
UPLOAD_PASSPHRASE="change-me"

# Security: Shared secret the worker presents when writing job results back to
# the frontend's /api/jobs/update endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_INTERNAL_KEY="change-me"

# AI / Provider Abstractions: "mock" for tests/local dev or "gemini" for cloud
LLM_PROVIDER="gemini"
OCR_PROVIDER="tesseract"

# Frontend base URL, used by the worker to call back into the Next.js API
FRONTEND_URL="http://localhost:3000"

# Cloud Credentials (required for LLM_PROVIDER=gemini / OCR_PROVIDER=glm-ocr)
GEMINI_API_KEY=""

# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME=""
